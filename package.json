{
  "name": "player",
  "productName": "Player",
  "private": true,
  "version": "1.4.2",
  "description": "Multitrack stem player for live performance: click, sections, loops, mixer and multi-output routing.",
  "author": "BlueMoon1337",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "desktopName": "player.desktop",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "build:web": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "preview:web": "vite preview",
    "update-package": "node scripts/update-package.mjs",
    "publish-package": "node scripts/publish-package.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
